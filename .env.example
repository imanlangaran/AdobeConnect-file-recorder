# ac-rec configuration. Copy this file to `.env` (gitignored) and fill in values.
# Format: KEY=VALUE per line; `#` comments and empty lines ignored;
# `export KEY=VALUE` prefix allowed; surrounding single/double quotes stripped.
# A missing `.env` file is fine — built-in defaults apply.
# Non-empty environment variables override file values (except USERNAME/PASSWORD,
# which are file-only fallbacks for AC_USERNAME/AC_PASSWORD).
# `ac-rec serve` loads `--env <path>` (default `.env`); `ac-rec download` reads `./.env`.

# --- Adobe Connect login (used by `download` and `serve` workers) ---
# AC_USERNAME: login email/username. Possible: any non-empty string. No default; required
#   unless you pass --session/--cookie to `download`. (USERNAME= works as a file-only fallback.)
AC_USERNAME=you@example.com
# AC_PASSWORD: login password. Possible: any non-empty string. No default; required
#   together with AC_USERNAME. (PASSWORD= works as a file-only fallback.)
AC_PASSWORD=secret

# --- Queue service (`ac-rec serve`) ---
# PORT: HTTP listen port for the status page (GET /) and JSON API
#   (POST /api/tasks, GET /api/tasks, GET /api/tasks/{id}, GET /healthz).
#   Possible: 1-65535. Default: 8080.
# PORT=8080

# DATA_DIR: directory holding the persistent queue (queue.json or queue.db).
#   Possible: any writable dir path, relative or absolute (Docker: /data).
#   Default: ./data.
# DATA_DIR=./data

# REPOSITORY_TYPE: storage backend for the queue.
#   Possible: file (JSON, default) | sqlite (queue.db, WAL). An unknown value
#   fails startup rather than silently falling back to file.
#   Switching to sqlite on first start imports an existing queue.json into
#   queue.db and renames it to queue.json.migrated (nothing is deleted).
#   Default: file.
# REPOSITORY_TYPE=file

# OUT_DIR: parent directory for finished recordings (./<OUT_DIR>/<title>/recording.mp4, ...).
#   Possible: any writable dir path (Docker: /recordings). Default: ./recordings.
# OUT_DIR=./recordings

# MAX_WORKERS: how many tasks are downloaded/reconstructed in parallel (one ffmpeg each).
#   Possible: integer >= 1 (values < 1 are clamped to 1). Default: 2.
#   Rule of thumb: ~1 worker per 2 CPU cores; raise if the queue keeps growing
#   (100 links/2h needs each job to average < MAX_WORKERS*72s).
# MAX_WORKERS=2

# RETRY_COUNT: retries per task after the first attempt fails (Claim counts attempts, so
#   total tries = 1 + RETRY_COUNT). Failures requeue after a 5s backoff; crashes
#   requeue on next startup without consuming the budget.
#   Possible: integer >= 0 (0 = try once, never retry). Default: 2.
# RETRY_COUNT=2

# --- Per-task output defaults (each queued URL inherits these) ---
# DEFAULT_RESOLUTION: output video size. Possible: 480p (=854x480), 720p (=1280x720),
#   1080p (=1920x1080). Unknown values fall back to 720p. Default: 720p.
# DEFAULT_RESOLUTION=720p

# DEFAULT_FPS: output frame rate. Possible: any positive integer; typical 12|15|25|30.
#   Lower (e.g. 12) renders screen-share recordings ~4x faster. Default: 25.
# DEFAULT_FPS=25

# DEFAULT_PRESET: x264 encoding preset (speed vs compression).
#   Possible: ultrafast|superfast|veryfast|faster|fast|medium|slow|slower|veryslow
#   (left = faster encode, bigger file). Default: veryfast.
# DEFAULT_PRESET=veryfast

# DEFAULT_CRF: x264 quality (Constant Rate Factor). Possible: 0-51; sensible range 18-28.
#   Higher = smaller/softer/faster, lower = bigger/sharper/slower (0 = lossless, pointless here).
#   Default: 23.
# DEFAULT_CRF=23

# EXPORT_MP3: also export an audio-only recording.mp3 next to recording.mp4.
#   Possible: true|false (also accepts 1/0, t/f, TRUE/FALSE, ...). Default: true.
# EXPORT_MP3=true
