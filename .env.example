# Credentials for `ac-rec download`. Copy this file to `.env` (gitignored)
# and fill in your Adobe Connect login.
#
# When --session is absent and .env exists in the current directory, the
# download logs in via /api/xml?action=login and uses the returned session
# cookies automatically. USERNAME=/PASSWORD= work as fallback key names.
AC_USERNAME=you@example.com
AC_PASSWORD=secret
